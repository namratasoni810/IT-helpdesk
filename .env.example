# ---------------------------------------------------------------------------
# Local prototype configuration.
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored so secrets never get committed.
# ---------------------------------------------------------------------------

# Postgres connection. This is the ONLY thing that needs to change when you
# repoint the app at Databricks Lakebase (or any other Postgres endpoint).
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk

# Anthropic API key for the classification module.
# Leave blank to run in "mock mode" (no API calls, deterministic fake results)
# so you can test the whole flow without spending tokens.
ANTHROPIC_API_KEY=

# Model used for classification.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Classifier backend: agent | mock | anthropic; empty keeps current behavior.
CLASSIFIER_MODE=
AGENT_APP_NAME=

# How often (seconds) the background worker polls for new tickets.
WORKER_POLL_INTERVAL=5

# FastAPI backend port
API_PORT=8000

# Streamlit UI port
STREAMLIT_PORT=8501
